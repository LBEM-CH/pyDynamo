#!/bin/bash
# pydynamo-shell: an interactive shell with pyDynamo's environment active and nothing from SBGrid, conda or the login
# profile (they can change Python, Qt and CUDA libraries without notice). Kept: HOME, USER, the X display (for dcp,
# dview, dmapview), the terminal, and Slurm's commands (sbatch, squeue, ...) from wherever this site installs them.
#
#   <repository>/prototype/bin/pydynamo-shell        then: dcp, daverage, sbatch ...
#   exit                                                                          back to the normal shell
HERE="$(cd "$(dirname "$(readlink -f "$0")")/../.." && pwd)"
ENV="$HERE/.envs/pydynamo"
if [ ! -f "$ENV/bin/activate" ]; then
  echo "pydynamo-shell: no pyDynamo environment at $ENV (see requirements/README-env.txt)" >&2
  exit 1
fi
# Slurm: the directory that holds sbatch in the calling shell (here /usr/local/slurm/bin), only that one
SLURM_BIN=""
if command -v sbatch >/dev/null 2>&1; then
  SLURM_BIN="$(dirname "$(command -v sbatch)")"
elif [ -x /usr/local/slurm/bin/sbatch ]; then
  SLURM_BIN=/usr/local/slurm/bin
fi
NEWPATH="/usr/bin:/bin"
[ -n "$SLURM_BIN" ] && NEWPATH="$SLURM_BIN:$NEWPATH"
RC="$(mktemp "${TMPDIR:-/tmp}/pydynamo-shell.XXXXXX")"
cat > "$RC" <<EOF
source "$ENV/bin/activate"
rm -f "$RC"
echo "pyDynamo shell (no SBGrid). Commands: dcp, dtrandomize_azimuth, daverage, dview, dmapview, pydynamo, ./NAME.exe$([ -n "$SLURM_BIN" ] && echo ", sbatch") -- exit leaves."
EOF
exec env -i HOME="$HOME" USER="$USER" LOGNAME="${LOGNAME:-$USER}" TERM="${TERM:-xterm}" LANG="${LANG:-C.UTF-8}" \
  ${DISPLAY:+DISPLAY="$DISPLAY"} ${XAUTHORITY:+XAUTHORITY="$XAUTHORITY"} PATH="$NEWPATH" \
  bash --noprofile --rcfile "$RC" -i
